# Copy this file to .env and select a model already installed in Ollama.
ECK_OLLAMA_MODEL=
ECK_SUPERVISOR_MODEL=
ECK_SUPERVISOR_ENABLED=true
ECK_SUPERVISOR_INITIAL_DELAY_SECONDS=30
ECK_SUPERVISOR_REVIEW_SECONDS=600
ECK_SUPERVISOR_MAX_REVIEWS_PER_DAY=48
ECK_SUPERVISOR_MAX_OUTPUT_TOKENS=512
ECK_SUPERVISOR_CONTEXT_WINDOW=4096
# Set to 0 for CPU-only supervision; 12 partially offloads qwen3:4b.
ECK_SUPERVISOR_NUM_GPU_LAYERS=12
ECK_LEARNING_STALL_MINUTES=30
ECK_SKILL_WORKER_ENABLED=true
ECK_SKILL_DEPENDENCY_INSTALL_ENABLED=true
ECK_AUTONOMOUS_LEARNING_PERCENT=90
ECK_CHALLENGE_EXECUTION_PERCENT=10
ECK_IMAGE_GENERATION_ENABLED=true
ECK_IMAGE_BACKEND=forge
ECK_IMAGE_ENGINE_PYTHON=workspace/image_engine/.venv/Scripts/python.exe
ECK_IMAGE_MODEL_DIR=workspace/models/stable-diffusion-v1-5
ECK_IMAGE_OUTPUT_DIR=workspace/generated_images
ECK_IMAGE_GENERATION_STEPS=36
ECK_IMAGE_GENERATION_GUIDANCE_SCALE=7.5
ECK_IMAGE_ADULT_CONTENT_ENABLED=true
ECK_IMAGE_ADETAILER_ENABLED=true
ECK_IMAGE_ADETAILER_MODEL=face_yolov8s.pt
ECK_FORGE_ROOT=workspace/forge
ECK_FORGE_BASE_URL=http://127.0.0.1:7861
ECK_FORGE_CHECKPOINT=realisticVisionV60B1_v60B1VAE.safetensors
ECK_FORGE_AUTO_START=true
ECK_REMBG_ENABLED=true
ECK_REMBG_PYTHON=workspace/rembg/.venv/Scripts/python.exe
ECK_REMBG_MODEL_DIR=workspace/rembg/models
ECK_REMBG_MODEL=birefnet-general

# Native Windows/WSL execution:
ECK_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Docker Desktop execution (uncomment):
# ECK_OLLAMA_BASE_URL=http://host.docker.internal:11434
