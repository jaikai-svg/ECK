# Copy this file to .env and select a model already installed in Ollama.
ECK_ARCHIVE_ROOT=
ECK_ARCHIVE_CACHE_DIR=workspace/archive-cache
ECK_ARCHIVE_CACHE_MAX_GB=10
ECK_ARCHIVE_REMOVE_LOCAL_AFTER_VERIFY=false
ECK_ARTIFACT_INDEX_REFRESH_SECONDS=60
ECK_LIBRARY_MIN_CARDS=24
ECK_LIBRARY_MIN_CHAPTERS=6
ECK_LIBRARY_MIN_RELATION_COVERAGE=0.6
ECK_LIBRARY_MIN_INDEPENDENT_SOURCE_RATIO=0.75
ECK_LIBRARY_MIN_APPLIED_TASKS=3
ECK_LIBRARY_MIN_FIXED_TESTS=3
ECK_LIBRARY_MIN_HIDDEN_TESTS=2
ECK_LIBRARY_MIN_EVALUATION_SCORE=0.82
ECK_OLLAMA_MODEL=
ECK_SUPERVISOR_MODEL=
ECK_CODER_MODEL=qwen2.5-coder:7b
ECK_OLLAMA_AUTO_START=true
ECK_OLLAMA_STARTUP_TIMEOUT_SECONDS=45
ECK_OLLAMA_KEEP_ALIVE=5m
ECK_SUPERVISOR_ENABLED=true
ECK_SUPERVISOR_INITIAL_DELAY_SECONDS=30
ECK_SUPERVISOR_REVIEW_SECONDS=600
ECK_SUPERVISOR_MAX_REVIEWS_PER_DAY=48
ECK_SUPERVISOR_MAX_OUTPUT_TOKENS=512
ECK_SUPERVISOR_CONTEXT_WINDOW=4096
# Set to 0 for CPU-only supervision; 12 partially offloads qwen3:4b.
ECK_SUPERVISOR_NUM_GPU_LAYERS=12
ECK_LEARNING_STALL_MINUTES=30
ECK_CRITICAL_RESEARCH_ENABLED=true
ECK_CRITICAL_RESEARCH_MAX_SOURCES=8
ECK_CRITICAL_RESEARCH_SNAPSHOT_RETENTION_DAYS=30
ECK_CRITICAL_RESEARCH_DEFAULT_TIMESPAN=7d
ECK_CRITICAL_RESEARCH_QUALITY_WINDOW=10
ECK_CRITICAL_RESEARCH_MAX_INCONCLUSIVE_RATIO=0.5
ECK_RAG_ENABLED=true
ECK_RAG_AUTO_DOWNLOAD=true
ECK_RAG_DATABASE_PATH=workspace/memory/eck-rag.sqlite3
ECK_RAG_MODEL_DIR=workspace/models/rag
ECK_RAG_EMBEDDING_MODEL=BAAI/bge-m3
ECK_RAG_RERANKER_MODEL=BAAI/bge-reranker-large
ECK_RAG_DEVICE=cpu
ECK_RAG_CANDIDATE_LIMIT=20
ECK_RAG_RESULT_LIMIT=2
ECK_RAG_MAX_SOURCE_RECORDS=2000
ECK_SKILL_WORKER_ENABLED=true
ECK_SKILL_DEPENDENCY_INSTALL_ENABLED=true
ECK_AUTONOMOUS_LEARNING_PERCENT=90
ECK_CHALLENGE_EXECUTION_PERCENT=10
ECK_IMAGE_GENERATION_ENABLED=true
ECK_IMAGE_BACKEND=forge
ECK_IMAGE_ENGINE_PYTHON=workspace/image_engine/.venv/Scripts/python.exe
ECK_IMAGE_MODEL_DIR=workspace/models/stable-diffusion-v1-5
ECK_IMAGE_OUTPUT_DIR=workspace/generated_images
ECK_IMAGE_GENERATION_STEPS=36
ECK_IMAGE_GENERATION_GUIDANCE_SCALE=7.5
ECK_IMAGE_ADULT_CONTENT_ENABLED=true
ECK_IMAGE_ADETAILER_ENABLED=true
ECK_IMAGE_ADETAILER_MODEL=face_yolov8s.pt
ECK_FORGE_ROOT=workspace/forge
ECK_FORGE_BASE_URL=http://127.0.0.1:7861
ECK_FORGE_CHECKPOINT=realisticVisionV60B1_v60B1VAE.safetensors
ECK_FORGE_AUTO_START=true
ECK_REMBG_ENABLED=true
ECK_REMBG_PYTHON=workspace/rembg/.venv/Scripts/python.exe
ECK_REMBG_MODEL_DIR=workspace/rembg/models
ECK_REMBG_MODEL=birefnet-general

# Native Windows/WSL execution:
ECK_OLLAMA_BASE_URL=http://127.0.0.1:11434

# P5 verified autonomous development. GitHub CLI authentication remains a
# one-time human credential step; ECK never stores the GitHub token itself.
ECK_AUTONOMOUS_PROJECT_LAB_ENABLED=true
ECK_AUTONOMOUS_PROJECT_DRAFT_ATTEMPTS=3
ECK_TOOL_CAMPAIGN_ENABLED=true
ECK_TOOL_CAMPAIGN_INITIAL_DELAY_SECONDS=3600
ECK_TOOL_CAMPAIGN_INTERVAL_SECONDS=21600
ECK_TOOL_CAMPAIGN_TARGET_COUNT=100
ECK_TOOL_CAMPAIGN_MIN_STARS=500
ECK_TOOL_CAMPAIGN_AUTO_PUBLISH=true
ECK_TOOL_CAMPAIGN_WORKSPACE_DIR=workspace/projects/eck-agent-toolkit
ECK_DURABLE_MISSION_EXECUTOR_ENABLED=true
ECK_MISSION_WORKSPACE_DIR=workspace/missions
ECK_MISSION_INTERNAL_REVIEW_ROUNDS=3
ECK_MISSION_DELIBERATION_MAX_ROUNDS=5
ECK_MISSION_QUALITY_MIN_SCORE=82
ECK_MISSION_REFERENCE_SEARCH_LIMIT=5
ECK_MISSION_WORKSPACE_MAX_MB=256
ECK_MISSION_WORKSPACE_TOTAL_MAX_GB=5
ECK_MISSION_RETENTION_DAYS=30
ECK_MISSION_PUBLISH_VERIFIED_PROJECTS=true
# ECK_MISSION_ARCHIVE_DIR=Z:/ECK/mission-archive
ECK_FEDERATION_ENABLED=true
ECK_FEDERATION_MIN_REPRODUCTIONS=2
ECK_FEDERATION_REGISTRY_MIN_REVIEWS=2
ECK_FEDERATION_REGISTRY_MIN_TRUST_SCORE=85
ECK_FEDERATION_SYNTHESIS_MIN_PACKS=4
ECK_FEDERATION_SYNTHESIS_MIN_TYPES=3
ECK_FEDERATION_COSIGN_ENABLED=true
# ECK_FEDERATION_COSIGN_EXECUTABLE=C:/Tools/cosign.exe
# ECK_FEDERATION_COSIGN_KEY_PATH=C:/ECK-keys/cosign.key
# ECK_FEDERATION_COSIGN_PUBLIC_KEY_PATH=C:/ECK-keys/cosign.pub
# For keyless bundles, pin both certificate identity and OIDC issuer during verification.
# ECK_FEDERATION_COSIGN_CERTIFICATE_IDENTITY=https://github.com/org/repo/.github/workflows/release.yml@refs/heads/main
# ECK_FEDERATION_COSIGN_OIDC_ISSUER=https://token.actions.githubusercontent.com
ECK_GITHUB_PUBLISH_ENABLED=true
ECK_GITHUB_AUTO_PUBLISH_VERIFIED_PROJECTS=true
ECK_GITHUB_ACCOUNT=
ECK_GITHUB_DEFAULT_VISIBILITY=private

# Docker Desktop execution (uncomment):
# ECK_OLLAMA_BASE_URL=http://host.docker.internal:11434
